{
  "name": "sandy",
  "version": "0.0.0",
  "description": "Desktop app to run AI coding agents in Docker Sandboxes",
  "author": "Crocogiciel Studio",
  "homepage": "https://github.com/Crocogiciel-Studio/sandy",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "./out/main/main.js",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "dist": "electron-builder --publish never"
  },
  "dependencies": {
    "@fontsource/commit-mono": "5.3.0",
    "@fontsource/instrument-sans": "5.3.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/headless": "6.0.0",
    "@xterm/xterm": "6.0.0",
    "node-pty": "1.2.0-beta.18",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "eslint": "10.14.0",
    "eslint-plugin-boundaries": "7.4.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
